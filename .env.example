# Copy this file to .env and fill in your real values.
# .env is gitignored so credentials never get committed.

# ===== DolphinDB =====
DDB_HOST=localhost
DDB_CONTROLLER_PORT=8900
DDB_DATA_PORT=8902
DDB_COMPUTE_PORT=8903
DDB_USER=admin
DDB_PASSWORD=changeme
DDB_CLUSTER_MODE=cluster

# ===== FMP (for later steps, not used by test_connect.py) =====
FMP_API_KEY=your_fmp_ultimate_api_key_here

# Stratechery Plus private feeds (get from stratechery.com account page)
STRATECHERY_RSS_ARTICLES=https://stratechery.passport.online/feed/rss/YOUR_TOKEN
STRATECHERY_RSS_PODCAST=https://stratechery.passport.online/feed/podcast/YOUR_TOKEN
# Substack session cookie for fetch_substack.py (browser F12 -> connect.sid value)
SUBSTACK_SID=YOUR_COOKIE_VALUE
